<resources>
    <string name="app_name">Roboco</string>

    <!-- The pairing root (android-ui-parity #34): the iOS SignIn layout with
         Roboco's copy (web app-shell.tsx Welcome strings, "browser"→"phone"). -->
    <string name="pairing_root_title" translatable="false">Roboco</string>
    <string name="pairing_root_tagline">This phone has no paired engine yet.</string>
    <string name="pairing_root_pair">Pair an engine</string>
    <string name="pairing_root_redeeming">Redeeming the pairing link…</string>

    <!-- The Pair page (android-ui-parity #72): the web pair page's copy
         ("browser"→"phone"; the placeholder and hint carry the web's
         Tailcat half again since android-next#02 — the phone redeems
         roboco-tailcat: invites through its own in-process Tailcat
         tunnel), the hint and cleartext note from android-app#18, the
         error sentences from the web's pairing-errors.ts plus the three
         Tailcat failures. Ellipses are U+2026, the em dash U+2014, "→"
         U+2192, "·" U+00B7; apostrophes are ASCII. -->
    <string name="pair_title">Pair this phone</string>
    <string name="pair_section">Pairing link</string>
    <string name="pair_placeholder" translatable="false">https://…/pair#token=…, roboco-tailcat:… or roboco-room:…</string>
    <string name="pair_paste">Paste</string>
    <string name="pair_scan">Scan QR code</string>
    <string name="pair_hint">Paste a pairing link, a roboco-tailcat: invite, or a roboco-room: room invite from any engine. Create one on that computer under Settings → Remote access.</string>
    <string name="pair_target">Engine at %1$s</string>
    <string name="pair_target_tailcat">Engine over Tailcat · invite expires in %1$s</string>
    <string name="pair_cleartext">This link uses http://, so pairing and your session aren\'t encrypted. Use a trusted network or your own tunnel.</string>
    <string name="pair_submit">Pair engine</string>
    <string name="pair_submitting">Pairing…</string>
    <string name="pair_submitting_tailcat">Connecting through Tailcat…</string>
    <string name="pair_error_refused">That pairing link did not work — it may have expired or already have been used.</string>
    <string name="pair_error_unreachable">Could not reach that engine. Check the URL and that the engine is running.</string>
    <string name="pair_error_tailcat_expired">That Tailcat invite has expired. Run roboco engine tailcat invite again.</string>
    <string name="pair_error_tailcat_unreachable">Could not reach that engine over Tailcat. Check that it is running and online.</string>
    <string name="pair_error_tailcat_unavailable">Tailcat isn\'t available in this build.</string>
    <string name="pair_error_failed">Pairing failed.</string>
    <string name="pair_error_store">Couldn\'t save the engine\'s credential on this phone.</string>
    <string name="pair_error_details_show">Show details</string>
    <string name="pair_error_details_hide">Hide details</string>

    <!-- Rooms (ADR 0011, ticket 04): the Pair page's join-room arm —
         the target line under a parsed roboco-room: invite (the room
         name and the member count only; the secret and the addresses
         never render), the capsule pair, and the two room-specific
         error sentences. A member engine without rooms-v1 never
         reaches here: the join skips it silently (hide, not toast). -->
    <string name="pair_room_target">Room “%1$s” · %2$d engines</string>
    <string name="pair_room_submit">Join room</string>
    <string name="pair_room_submitting">Joining room…</string>
    <string name="room_error_refused">That room invite was refused — its secret may have rotated, or a member left the room.</string>
    <string name="room_error_throttled">That engine is throttling room joins. Try again in a minute.</string>

    <!-- Fleet follow (fleet-follow ticket 04): after a pairing, the
         engine's fleet joins silently. Only these two toasts ever show —
         a progress line while the join runs, and the count of engines it
         added (none when every member was already paired). A missing
         fleet, an old engine or a failed join shows nothing at all. -->
    <string name="fleet_joining">Adding the rest of your fleet…</string>
    <plurals name="fleet_joined">
        <item quantity="one">Added %d engine from your fleet</item>
        <item quantity="other">Added %d engines from your fleet</item>
    </plurals>

    <!-- The QR scanner (android-ui-parity #138): the hint, foreign,
         denied and unavailable captions (qr_denied/qr_foreign/qr_hint are
         android-app#18's wording verbatim; qr_unavailable is new — see the
         ticket's Comments), the denied-state capsule and the ✕ label
         (UIKit's .close, not ImageViewer's "Close image preview"). The
         pane title reuses pair_scan. Apostrophes are ASCII, matching 72. -->
    <string name="qr_hint">Point the camera at a pairing QR code</string>
    <string name="qr_foreign">That QR code isn\'t a Roboco pairing link.</string>
    <string name="qr_denied">Camera access is off. Allow it in Settings to scan, or paste the link instead.</string>
    <string name="qr_open_settings">Open Settings</string>
    <string name="qr_unavailable">The camera isn\'t available right now. Paste the link instead.</string>
    <string name="qr_close">Close</string>

