{
  "name": "roboco-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.24",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "tsx": "^4.20.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.18.1",
    "@types/node": "^24.10.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-expo-dev-launcher.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.cjs src/*.test.mjs tests/*.test.ts",
    "export:android": "expo export --platform android",
    "prebuild:android": "expo prebuild --platform android",
    "build:aar": "sh Native/build-aar.sh",
    "build:android": "npm run build:aar && npm run prebuild:android && cd android && ./gradlew :app:assembleRelease",
    "test:engine": "ROBOCO_MOBILE_ENGINE_TEST=1 tsx --test tests/engine.test.ts"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "private": true,
  "packageManager": "npm@11.19.0"
}
